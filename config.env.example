# Copy to config.env and fill in. config.env is git-ignored; never commit it.

# AWS
AWS_PROFILE=lightning-demo
AWS_REGION=us-east-1
OWNER=

# S3 raw zone. Must be globally unique; start with olist-lightning-
S3_BUCKET=

# RDS PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=olist
DB_USER=postgres
# Password is never stored here. It is fetched from Secrets Manager at runtime.
DB_SECRET_NAME=

# Dashboard read-only role
BI_USER=bi_reader

# Spotify data agent (spotify/). Same RDS instance, its own database.
SPOTIFY_DB_NAME=spotify
# Raw zone: "s3" lands files in s3://$S3_BUCKET/raw/spotify/; any other value is a local folder (default data/)
SPOTIFY_RAW=s3
# The agent logs in as agent_reader. Its password lives in Secrets Manager, never here.
AGENT_SECRET_NAME=
# Local development only: point both at a local Postgres instead of RDS. Leave empty on AWS.
SPOTIFY_DATABASE_URL=
SPOTIFY_AGENT_DATABASE_URL=
